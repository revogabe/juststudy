{
  "name": "@juststudy/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --parallel --no-orphans 'dev:*'",
    "dev:api": "bun --watch src/app/server.ts",
    "dev:studio": "drizzle-kit studio --host 127.0.0.1 --port 4983",
    "start": "bun src/app/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "database:generate": "drizzle-kit generate",
    "database:migrate": "drizzle-kit migrate",
    "openapi:generate": "bun src/app/openapi.ts",
    "benchmark:score": "bun benchmarks/score.benchmark.ts",
    "benchmark:evaluation": "bun benchmarks/evaluation.benchmark.ts",
    "benchmark:decision": "bun benchmarks/decision.benchmark.ts",
    "benchmark:topic": "bun benchmarks/topic.benchmark.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.60",
    "@ai-sdk/openai-compatible": "^3.0.44",
    "@elysiajs/openapi": "^2.0.0-exp.0",
    "@langfuse/client": "^5.11.0",
    "@langfuse/otel": "^5.11.0",
    "@langfuse/tracing": "^5.11.0",
    "@langfuse/vercel-ai-sdk": "^5.11.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@polar-sh/sdk": "0.47.1",
    "ai": "^7.0.93",
    "better-auth": "1.7.1",
    "drizzle-orm": "^0.45.2",
    "elysia": "^2.0.0-exp.64",
    "postgres": "^3.4.9",
    "resend": "6.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@better-auth/cli": "1.4.21",
    "drizzle-kit": "^0.31.10",
    "standardwebhooks": "^1.0.0"
  }
}
