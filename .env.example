TRANSCRIPTION_BASE_URL=http://127.0.0.1:8001
TRANSCRIPTION_TIMEOUT_MS=180000

OPENROUTER_API_KEY=

AI_PROVIDER_NAME=ollama
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_API_KEY=ollama
AI_EVALUATION_MODEL=qwen3.5:9b
AI_INPUT_PRICE_PER_MILLION=0
AI_OUTPUT_PRICE_PER_MILLION=0
AI_SUPPORTS_STRUCTURED_OUTPUTS=true
AI_REASONING_EFFORT=none
AI_TIMEOUT_MS=600000
AI_FALLBACK_TRANSIENT_COOLDOWN_MS=30000
AI_FALLBACK_QUOTA_COOLDOWN_MS=900000

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EVALUATION_MODEL=gpt-6-luna
OPENAI_INPUT_PRICE_PER_MILLION=0.1
OPENAI_OUTPUT_PRICE_PER_MILLION=0.5
OPENAI_REASONING_EFFORT=none
OPENAI_TIMEOUT_MS=120000

FEEDBACK_SHADOW_MODE=none

DECISION_PROVIDER_NAME=openrouter
DECISION_BASE_URL=https://openrouter.ai/api/v1
DECISION_API_KEY=
DECISION_MODEL=typesafe/jev-1.13
DECISION_INPUT_PRICE_PER_MILLION=0.042
DECISION_TIMEOUT_MS=30000

SHADOW_AI_PROVIDER_NAME=openrouter
SHADOW_AI_BASE_URL=https://openrouter.ai/api/v1
SHADOW_AI_API_KEY=
SHADOW_AI_MODEL=openai/gpt-6-luna
SHADOW_AI_INPUT_PRICE_PER_MILLION=0.1
SHADOW_AI_OUTPUT_PRICE_PER_MILLION=0.5
SHADOW_AI_REASONING_EFFORT=none

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
