APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=3000
APP_BASE_URL=http://127.0.0.1:3000
APP_WEB_URL=http://localhost:3001
E2E_TEST_MODE=false

DATABASE_URL=postgres://juststudy:juststudy@127.0.0.1:5432/juststudy

KNOWLEDGE_CATALOG_TOKEN=replace-with-at-least-32-characters
KNOWLEDGE_ASSESSMENT_GENERATION=false

AUTH_SECRET=replace-with-at-least-32-characters
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

EMAIL_PROVIDER=mailpit
EMAIL_FROM=no-reply@juststudy.test
RESEND_API_KEY=
